          "match_relationship": "matches",
          "match_condition": ""
        }
      ]
    },
    "intercept_server_responses": {
      "do_intercept": true,
      "rules": []
    },
    "match_replace_rules": []
  },
  "includeInExport": false,
  "matchReplaceScopeOnly": false
}